FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml /app/
COPY packages/domain /app/packages/domain
COPY apps/api /app/apps/api

RUN pip install --no-cache-dir \
    -e /app/packages/domain \
    fastapi uvicorn[standard] sqlalchemy pydantic-settings python-multipart \
    pypdf python-docx pyjwt bcrypt passlib "psycopg[binary]"

ENV PYTHONPATH=/app/apps/api/src:/app/packages/domain/src
EXPOSE 8000
CMD ["uvicorn", "resume_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
