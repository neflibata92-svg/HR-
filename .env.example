# API 服务器专用：生产环境必须替换密钥、关闭公开注册并限制 CORS
ENV=development
ALLOW_REGISTER=true
DATABASE_URL=sqlite:///./data/resume.db
STORAGE_DIR=./data/files
WATCH_DIR=./data/inbox
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14
CORS_ORIGINS=*
# 仅 development 生效，生产必须留空
DEV_API_TOKEN=dev-token-change-me

# API 服务器专用：第三方 LLM Key 禁止复制到 Web 或本机 Agent
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3

# 本机 Agent 专用：每位 HR 使用自己的个人系统 API Key
API_BASE_URL=http://127.0.0.1:8000
API_KEY=
MACHINE_ID=local-pc
# 以下目录包含登录 Profile、候选人页面截图或下载文件，不得同步到服务器、网盘或 Git
BROWSER_USER_DATA_DIR=./data/browser-profile
BROWSER_CHANNEL=
SCREENSHOT_DIR=./data/screenshots
DOWNLOAD_DIR=./data/downloads
SELECTORS_PATH=
OPEN_DETAIL_FOR_SEGMENTS=true
WAIT_ATTACHMENT_AFTER_GREET=true
